{
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/crossweft\" hook claude-code session-start --from-plugin", "timeout": 30}]}
    ],
    "PostToolUse": [
      {"matcher": "Edit|Write|MultiEdit|NotebookEdit",
       "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/crossweft\" hook claude-code post-edit --from-plugin", "timeout": 60}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/crossweft\" hook claude-code stop --from-plugin", "timeout": 120}]}
    ]
  }
}
